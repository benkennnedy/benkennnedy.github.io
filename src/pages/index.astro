---
import BaseLayout from '../layouts/BaseLayout.astro';

const postModules = import.meta.glob('./posts/*.md', { eager: true });
const posts = Object.entries(postModules)
  .map(([path, mod]) => ({ ...mod.frontmatter, slug: path.split('/').pop().replace('.md','') }))
  .sort((a,b) => new Date(b.date ?? 0).valueOf() - new Date(a.date ?? 0).valueOf())
  .slice(0,2);
const fmt = (d) => d ? new Date(d).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric', timeZone:'UTC' }) : '';

const certifications = [
  {
    name: 'CCNP Enterprise',
    logo: '/images/certifications/ccnp-enterprise.jpg',
    logoAlt: 'Cisco Certified CCNP Enterprise',
  },
  {
    name: 'Palo Alto NGFW Engineer Certified',
    logo: '/images/certifications/palo-alto-ngfw-engineer.png',
    logoAlt: 'Palo Alto Networks Next-Gen Firewall Engineer Certified',
  },
  {
    name: 'CCNP Automation',
    logo: '/images/certifications/ccnp-automation.png',
    logoAlt: 'Cisco Certified CCNP Automation',
  },
];
---
<BaseLayout>
  <main>
    <div class="container hero">
      <div class="hero-copy">
        <h1>Welcome!</h1>
        <p class="lede">Welcome to my website! I try to post consistently about the things I'm currently studying and labbing, or anything network-related.</p>
        <div class="actions"><a class="button primary" href="/posts">Read posts</a><a class="button" href="/contact">Contact</a></div>
      </div>
    </div>

    <section class="section"><div class="container"><div class="section-head"><div><h2>Recent Posts</h2></div></div>
      <div class="post-feed compact">
        {posts.map(post => <article class="post-feed-item"><time class="post-feed-date">{fmt(post.date)}</time><div class="post-feed-body"><div class="meta">{post.category ?? post.type ?? 'Post'}</div><h3><a href={`/posts/${post.slug}`}>{post.title}</a></h3><p>{post.summary}</p><div class="tags">{(post.tags ?? []).map(tag => <span class="tag">{tag}</span>)}</div><a class="read-more" href={`/posts/${post.slug}`}>Read post →</a></div></article>)}
      </div>
    </div></section>

    <section class="section" id="certifications">
      <div class="container">
        <div class="credentials-heading"><div class="eyebrow">Credentials</div><h2>Industry certifications.</h2></div>
        <div class="credentials-grid">
          {certifications.map(certification => (
            <article class="credential-card">
              <div class="credential-logo"><img src={certification.logo} alt={certification.logoAlt} width="140" height="140" loading="lazy" /></div>
              <div class="credential-content">
                <h3>{certification.name}</h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
